# Copy to .env only for a new installation. Keep your existing .env when updating.
DB_SERVER=YOUR_SQL_SERVER_INSTANCE
DB_NAME=YOUR_EXISTING_FARM_DATABASE
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUSTED_CONNECTION=yes
DB_TRUST_SERVER_CERTIFICATE=yes
JWT_SECRET_KEY=replace-with-a-long-random-secret
# Used only if starting uvicorn directly; run_farm.py sets this from --port.
FARM_FRONTEND_PORT=3000
FARM_TIMEZONE=Asia/Manila
OPENWEATHER_API_KEY=
SEED_ADMIN_PASSWORD=

# Optional national warnings from OpenWeather One Call 3.0. Requires eligible API access.
# Leave false to keep the existing current/forecast requests only.
OPENWEATHER_OFFICIAL_ALERTS_ENABLED=false

# Backup control data is outside the farm database. Review Windows ACLs.
BACKUP_CONTROL_DIR=storage/backup_control
BACKUP_SQL_DIRECTORY=
BACKUP_WORKER_ENABLED=true
BACKUP_WORKER_INTERVAL_SECONDS=5
BACKUP_ACTIVATION_ENABLED=false
BACKUP_MAX_UPLOAD_BYTES=4294967296
BACKUP_GOOGLE_CLIENT_ID=
BACKUP_GOOGLE_CLIENT_SECRET=
BACKUP_GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/backup-recovery/drive/callback
BACKUP_FRONTEND_RETURN_URL=http://localhost:3000/settings?section=data
