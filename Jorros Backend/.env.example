# Copy to .env only for a new installation. Keep your existing .env when updating.
DB_SERVER=YOUR_SQL_SERVER_INSTANCE
DB_NAME=YOUR_EXISTING_FARM_DATABASE
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUSTED_CONNECTION=yes
DB_TRUST_SERVER_CERTIFICATE=yes
JWT_SECRET_KEY=replace-with-a-long-random-secret
# Used only if starting uvicorn directly; run_farm.py sets this from --port.
FARM_FRONTEND_PORT=3000
FARM_TIMEZONE=Asia/Manila
OPENWEATHER_API_KEY=
SEED_ADMIN_PASSWORD=

# Optional national warnings from OpenWeather One Call 3.0. Requires eligible API access.
# Leave false to keep the existing current/forecast requests only.
OPENWEATHER_OFFICIAL_ALERTS_ENABLED=false
